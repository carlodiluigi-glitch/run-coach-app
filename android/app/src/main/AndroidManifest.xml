<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== PERMESSI ====================
         Solo i permessi realmente necessari all'app:

         - ACCESS_FINE_LOCATION  : posizione GPS precisa, indispensabile per
                                   misurare distanza e passo.
         - ACCESS_COARSE_LOCATION: richiesto insieme al precedente da Android 12+
                                   (l'utente puo' concedere solo la precisione
                                   approssimativa).

         NON sono richiesti permessi di background, Bluetooth o storage:
         in questa versione la corsa si registra con l'app in primo piano e i
         dati restano nella cartella privata dell'app.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ========== REGISTRAZIONE IN BACKGROUND ==========
         Durante la corsa l'app avvia un "foreground service" di tipo
         location: compare una notifica permanente e Android si impegna a non
         chiudere il processo. Cosi' la registrazione continua con lo schermo
         spento e il telefono in tasca.

         NOTA IMPORTANTE: con questo approccio NON serve il permesso
         ACCESS_BACKGROUND_LOCATION ("Consenti sempre"), che e' invasivo e
         difficile da giustificare sugli store. Basta il permesso posizione
         concesso "mentre l'app e' in uso".
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Tiene la CPU sveglia mentre si registra, altrimenti Android sospende
         il processo dopo qualche minuto di schermo spento e si perdono punti. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Da Android 13 la notifica della registrazione richiede il consenso
         dell'utente. Se negato la corsa si registra lo stesso, ma senza
         notifica visibile. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Il GPS e' fortemente consigliato ma non obbligatorio per installare. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="Run Coach"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Necessario a flutter_tts per individuare il motore vocale. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
