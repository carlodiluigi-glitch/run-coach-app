<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== PERMESSI ====================
         Solo i permessi realmente necessari all'app:

         - ACCESS_FINE_LOCATION  : posizione GPS precisa, indispensabile per
                                   misurare distanza e passo.
         - ACCESS_COARSE_LOCATION: richiesto insieme al precedente da Android 12+
                                   (l'utente puo' concedere solo la precisione
                                   approssimativa).

         NON sono richiesti permessi di background, Bluetooth o storage:
         in questa versione la corsa si registra con l'app in primo piano e i
         dati restano nella cartella privata dell'app.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ========== REGISTRAZIONE IN BACKGROUND ==========
         Durante la corsa l'app avvia un "foreground service" di tipo
         location: compare una notifica permanente e Android si impegna a non
         chiudere il processo. Cosi' la registrazione continua con lo schermo
         spento e il telefono in tasca.

         NOTA IMPORTANTE: con questo approccio NON serve il permesso
         ACCESS_BACKGROUND_LOCATION ("Consenti sempre"), che e' invasivo e
         difficile da giustificare sugli store. Basta il permesso posizione
         concesso "mentre l'app e' in uso".
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Tiene la CPU sveglia mentre si registra, altrimenti Android sospende
         il processo dopo qualche minuto di schermo spento e si perdono punti. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ========== RISPARMIO ENERGETICO ==========
         La causa numero uno delle corse perse non e' il GPS: e' Android che
         addormenta l'app per risparmiare batteria. Con questo permesso si
         puo' CHIEDERE all'utente di escludere Falcata da quel meccanismo -
         chiedere, non imporre: la finestra la apre il sistema e decide lui.

         Sui telefoni Xiaomi, Huawei e Oppo non basta: hanno un gestore loro,
         con un'impostazione "avvio automatico" che sta in un altro posto per
         ogni marca. Per quelli l'app apre la propria pagina di sistema e
         spiega cosa cercare. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Da Android 13 la notifica della registrazione richiede il consenso
         dell'utente. Se negato la corsa si registra lo stesso, ma senza
         notifica visibile. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ========== NIENTE INTERNET ==========
         Falcata non dichiara il permesso INTERNET, e non e' una dimenticanza:
         e' una promessa che si puo' verificare. Senza quel permesso Android
         **impedisce** all'app di aprire una connessione, quindi non e' una
         questione di fiducia - non puo' proprio, nemmeno per sbaglio e nemmeno
         con un aggiornamento sbagliato.

         Vuol dire che niente di quello che registri esce da questo telefono:
         non le corse, non le posizioni, non il nome. Non ci sono account, non
         c'e' un server, non c'e' niente da violare.

         L'unica funzione che l'avrebbe voluto era la mappa vera sotto al
         percorso, ed e' parcheggiata: il disegno del giro si fa senza rete.
    -->


    <!-- ========== LA CADENZA ==========
         Da Android 10 leggere il sensore dei passi richiede questo permesso.
         Serve SOLO per la cadenza di corsa - quanti appoggi al minuto - e non
         da' accesso a nient'altro: non alla posizione, non alla salute, non
         allo storico delle attivita' di Google.

         Se l'utente lo nega l'app funziona esattamente come prima, solo senza
         il grafico della cadenza. Per questo non viene chiesto all'avvio ma
         alla prima corsa, e non si insiste. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Il sensore dei passi non c'e' su tutti i telefoni: l'app si installa
         comunque e la cadenza semplicemente non compare. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <!-- Il GPS e' fortemente consigliato ma non obbligatorio per installare. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="Falcata"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Necessario a flutter_tts per individuare il motore vocale. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
