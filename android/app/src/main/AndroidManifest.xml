<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ==================== PERMESSI ====================
         Solo i permessi realmente necessari all'app:

         - ACCESS_FINE_LOCATION  : posizione GPS precisa, indispensabile per
                                   misurare distanza e passo.
         - ACCESS_COARSE_LOCATION: richiesto insieme al precedente da Android 12+
                                   (l'utente puo' concedere solo la precisione
                                   approssimativa).

         - FOREGROUND_SERVICE e FOREGROUND_SERVICE_LOCATION: permettono di
                                   continuare a registrare la corsa a schermo
                                   spento, tramite un servizio in primo piano
                                   con notifica visibile.
         - POST_NOTIFICATIONS    : da Android 13 serve per mostrare quella
                                   notifica.

         NON e' richiesto ACCESS_BACKGROUND_LOCATION: con il servizio in primo
         piano non serve, e chiederlo comporterebbe una revisione aggiuntiva
         sul Play Store. Bluetooth e storage restano fuori.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Il GPS e' fortemente consigliato ma non obbligatorio per installare. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:label="Run Coach"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Necessario a flutter_tts per individuare il motore vocale. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
